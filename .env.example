# =================================================================
# Ocenit.online — Environment variables
# Zkopíruj do .env.local pro lokální dev, do Vercel Env Vars pro produkci.
# =================================================================

# --- Auth (povinné) ---
# Vygeneruj: openssl rand -base64 32
AUTH_SECRET=

# URL pro sestavení magic linků. Na Vercelu můžeš nechat prázdné (odvodí z VERCEL_URL).
# Pro produkci nastav na https://www.ocenit.online
APP_URL=http://localhost:3000

# --- Vercel Postgres (Vercel doplní automaticky po připojení storage) ---
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# --- Realvisor API (pro oceňování) ---
REALVISOR_API_URL=https://api-production-88cf.up.railway.app/api/v1
REALVISOR_API_KEY=

# --- PTF email API (magic link a měsíční digest) ---
PTF_EMAIL_API_URL=https://ptf-production.up.railway.app/api/email/send
PTF_EMAIL_API_KEY=
PTF_EMAIL_FROM=noreply@ocenit.online
PTF_EMAIL_FROM_NAME=Ocenit.online

# --- PTF blog API (už existuje, pro proxy /api/blog) ---
PTF_BACKEND_URL=https://ptf-production.up.railway.app

# --- Nemovizor API (pro data okolí v digestu, volitelné pro MVP) ---
NEMOVIZOR_API_URL=
NEMOVIZOR_API_KEY=

# --- Vercel Cron (zabezpečení cronu proti veřejnému volání) ---
# Vygeneruj: openssl rand -hex 32
CRON_SECRET=
